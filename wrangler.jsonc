{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "quiet-kind",
	"main": "src/worker.js",
	"compatibility_date": "2025-09-01",
	"observability": {
		"enabled": true
	},
	// the game itself is static files in ./public; only /api/* runs the Worker
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "quiet-kind-db",
			"database_id": "e09c4179-972f-4fe6-9ee9-8c5b1d341af9",
			"remote": true,
			"migrations_dir": "migrations"
		}
	]
}